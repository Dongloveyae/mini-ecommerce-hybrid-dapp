# Backend Server Port
PORT=5000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mini_ecommerce_dapp

# Blockchain Configuration (Ethers.js Listener)
# Hardhat Local RPC: http://127.0.0.1:8545
# Sepolia RPC: https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY hoặc https://rpc.sepolia.org
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Địa chỉ Contract được cấu hình tập trung tại file .env gốc (D:\DA-BlockChain\.env)
# CONTRACT_ADDRESS=
